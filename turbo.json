{
	"$schema": "https://turborepo.org/schema.json",
	"globalDependencies": ["**/.env"],
	"pipeline": {
		"dev": {
			"persistent": true,
			"cache": false
		},
		"dev:mobile": {
			"persistent": true,
			"cache": false
		},
		"dev:desktop": {
			"persistent": true,
			"cache": false,
			"env": [
				"PORT",
				"LOGGING_ENABLED",
				"LOGGING_LEVEL",
				"JWT_ALGORITHM",
				"JWT_EXPIRATION",
				"JWT_SECRET",
				"JWT_COOKIE_NAME",
				"MONGODB_URI",
				"MONGODB_DATA_DB_NAME",
				"MONGODB_USER_DB_NAME",
				"GOOGLE_CLIENT_ID",
				"GOOGLE_CLIENT_SECRET",
				"GOOGLE_REDIRECT_URL",
				"NUTS_GITHUB_API_KEY"
			]
		},
		"dev:web": {
			"persistent": true,
			"cache": false,
			"env": [
				"PORT",
				"LOGGING_ENABLED",
				"LOGGING_LEVEL",
				"JWT_ALGORITHM",
				"JWT_EXPIRATION",
				"JWT_SECRET",
				"JWT_COOKIE_NAME",
				"MONGODB_URI",
				"MONGODB_DATA_DB_NAME",
				"MONGODB_USER_DB_NAME",
				"GOOGLE_CLIENT_ID",
				"GOOGLE_CLIENT_SECRET",
				"GOOGLE_REDIRECT_URL",
				"NUTS_GITHUB_API_KEY"
			]
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".expo/**"]
		},
		"lint": {},
		"lint:fix": {},
		"clean": {
			"cache": false
		},
		"//#clean": {
			"cache": false
		},
		"type-check": {}
	},
	"globalEnv": ["CI", "EXPO_ROUTER_APP_ROOT", "NODE_ENV", "SKIP_ENV_VALIDATION"]
}
