{
	"name": "taskly",
	"private": true,
	"engines": {
		"node": "18.17"
	},
	"scripts": {
		"build": "turbo build",
		"clean": "git clean -xdf node_modules",
		"clean:workspaces": "turbo clean",
		"dev": "turbo dev --parallel",
		"dev:mobile": "turbo dev:mobile --parallel",
		"dev:desktop": "turbo dev:desktop --parallel",
		"dev:web": "turbo dev:web --parallel",
		"format": "prettier --write \"**/*.{js,cjs,mjs,ts,tsx,md,json}\" --ignore-path .gitignore",
		"lint": "turbo lint && manypkg check",
		"lint:fix": "turbo lint:fix && manypkg fix",
		"type-check": "turbo type-check",
		"deploy:server": "flyctl deploy --config ./apps/server/fly.toml --dockerfile ./apps/server/Dockerfile --ignorefile ./.dockerignore --local-only"
	},
	"dependencies": {
		"@manypkg/cli": "^0.20.0",
		"@types/prettier": "^2.7.3",
		"eslint": "^8.42.0",
		"eslint-config-custom": "*",
		"prettier": "^2.8.8",
		"prettier-plugin-tailwindcss": "^0.3.0",
		"turbo": "^1.10.1",
		"typescript": "^5.1.3"
	},
	"packageManager": "yarn@1.22.19",
	"workspaces": [
		"apps/mobile",
		"apps/desktop",
		"apps/server",
		"apps/web",
		"packages/config/*",
		"packages/web-ui"
	]
}
