{
	"name": "@taskly/desktop",
	"productName": "Taskly",
	"version": "0.1.0",
	"main": ".webpack/main",
	"private": true,
	"scripts": {
		"clean": "git clean -xdf .webpack .turbo node_modules",
		"dev:desktop": "NODE_ENV=development electron-forge start --inspect-electron",
		"package": "NODE_ENV=production electron-forge package",
		"make": "NODE_ENV=production electron-forge make",
		"publish": " NODE_ENV=production electron-forge publish",
		"lint": "eslint --ext .ts,.tsx .",
		"lint:fix": "eslint --fix --ext .ts,.tsx .",
		"type-check": "tsc --noEmit",
		"icon:generate": "electron-icon-builder --flatten --input=./src/assets/base_icon.png --output=./src/assets",
		"start": "electron-forge start"
	},
	"keywords": [],
	"author": "Asier Zapata",
	"description": "Taskly Desktop App",
	"license": "MIT",
	"devDependencies": {
		"@electron-forge/cli": "^6.2.1",
		"@electron-forge/maker-deb": "^6.2.1",
		"@electron-forge/maker-rpm": "^6.2.1",
		"@electron-forge/maker-squirrel": "^6.2.1",
		"@electron-forge/maker-zip": "^6.2.1",
		"@electron-forge/plugin-webpack": "^6.1.1",
		"@types/dompurify": "^3.0.2",
		"@types/react": "^18.0.26",
		"@types/react-big-calendar": "^1.6.4",
		"@types/react-dom": "^18.0.10",
		"@vercel/webpack-asset-relocator-loader": "1.7.3",
		"autoprefixer": "^10.4.14",
		"css-loader": "^6.0.0",
		"electron": "25.1.0",
		"electron-icon-builder": "^2.0.1",
		"fork-ts-checker-webpack-plugin": "^7.2.13",
		"node-loader": "^2.0.0",
		"postcss": "^8.4.24",
		"postcss-loader": "^7.0.2",
		"style-loader": "^3.0.0",
		"tailwindcss": "^3.3.2",
		"ts-loader": "^9.2.2",
		"ts-node": "^10.9.1",
		"typescript": "^5.1.3"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.8.0",
		"@codemirror/commands": "^6.2.4",
		"@codemirror/lang-markdown": "^6.1.1",
		"@codemirror/language": "^6.8.0",
		"@codemirror/language-data": "^6.3.1",
		"@codemirror/search": "^6.5.0",
		"@codemirror/state": "^6.2.1",
