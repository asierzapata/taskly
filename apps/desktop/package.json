		"@replit/codemirror-vscode-keymap": "^6.0.2",
		"@supabase/supabase-js": "2.24.0",
		"@taskly/web-ui": "*",
		"axios": "^1.4.0",
		"codemirror": "^6.0.1",
		"date-fns": "^2.30.0",
		"dompurify": "^3.0.3",
		"electron-squirrel-startup": "^1.0.0",
		"electron-store": "^8.1.0",
		"react": "^18.2.0",
		"react-big-calendar": "1.8.1",
		"react-dom": "18.2.0",
