{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"target": "ES6",
		"allowJs": true,
		"module": "commonjs",
		"skipLibCheck": true,
		"esModuleInterop": true,
		"noImplicitAny": true,
		"sourceMap": true,
		"baseUrl": ".",
		"outDir": "dist",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"paths": {
			"@renderer/*": ["./src/renderer/*"],
			"@modules/*": ["./src/modules/*"],
			"@services/*": ["./src/services/*"],
			"@/*": ["./src/*"],
			"*": ["node_modules/*"]
		},
		"jsx": "react"
	},
	"include": [
		"**/*.ts",
		"src/**/*",
		"src/**/*.tsx",
		"src/**/*.cjs",
		"src/**/*.mjs"
	],
	"exclude": ["node_modules"]
}
